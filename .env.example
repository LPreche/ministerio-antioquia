# Ambiente: 'development' (banco local) ou 'production' (banco Aiven/remoto)
NODE_ENV=development

# ==========================================
# BANCO DE DADOS LOCAL (Desenvolvimento)
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=movimento_antioquia
DB_SSL=false

# ==========================================
# BANCO DE DADOS EM NUVEM - AIVEN (Produção)
# Ativado quando NODE_ENV=production ou USE_PROD_DB=true
# ==========================================
PROD_DB_HOST=mysql-xxxxxxxx-seu-servico.aivencloud.com
PROD_DB_PORT=22195
PROD_DB_USER=avnadmin
PROD_DB_PASSWORD=sua_senha_aiven
PROD_DB_NAME=movimento_antioquia
PROD_DB_SSL=true

# ==========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ==========================================
SESSION_SECRET=sua_chave_secreta_aqui
ADMIN_USER=admin
ADMIN_PASSWORD="sua_senha_admin"

# Notificações WebPush (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
